# ==========================================
# RAILPLAN AI - DEPLOYMENT CONFIGURATION
# ==========================================

# 1. Frontend (Vercel) Environment Variables:
# Paste your Render backend URL once deployed, e.g.:
NEXT_PUBLIC_BACKEND_URL=https://railplan-backend.onrender.com

# 2. Backend (Render) Environment Variables:
# Paste your MongoDB Atlas Connection String here:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=railplan_ai
PORT=5000
